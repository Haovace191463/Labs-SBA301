<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fu.edu.sba301.ui.controller.StudentController"
            styleClass="page">
    <top>
        <VBox spacing="4" styleClass="header">
            <padding><Insets top="20" right="24" bottom="18" left="24"/></padding>
            <Label text="Student Management" styleClass="title"/>
            <Label text="JavaFX • FXML • Controller • Service boundary • Hibernate CRUD" styleClass="subtitle"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="16">
            <padding><Insets top="18" right="24" bottom="18" left="24"/></padding>
            <GridPane hgap="12" vgap="10" styleClass="form-card">
                <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                <columnConstraints>
                    <ColumnConstraints minWidth="80"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="180"/>
                    <ColumnConstraints minWidth="80"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="180"/>
                </columnConstraints>
                <Label text="Email *" GridPane.rowIndex="0"/>
                <TextField fx:id="txtEmail" promptText="name@example.com"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Điểm *" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="txtMarks" promptText="0 - 10"
                           GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <Label text="Họ *" GridPane.rowIndex="1"/>
                <TextField fx:id="txtFirstName" promptText="Nguyễn"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Tên *" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="txtLastName" promptText="An"
                           GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                <HBox spacing="9" GridPane.columnSpan="4" GridPane.rowIndex="2">
                    <Button text="Tạo mới" onAction="#handleCreate" styleClass="button-primary"/>
                    <Button text="Cập nhật" onAction="#handleUpdate"/>
                    <Button text="Xóa" onAction="#handleDelete" styleClass="button-danger"/>
                    <Button text="Làm trống" onAction="#handleClear"/>
                    <Button text="Refresh" onAction="#handleRefresh"/>
                    <Button fx:id="btnAsyncRefresh" text="Refresh nền" onAction="#handleAsyncRefresh"/>
                    <ProgressIndicator fx:id="progressLoading" prefWidth="24" prefHeight="24"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSelection" text="Chưa chọn dòng" styleClass="selection-label"/>
                </HBox>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Tìm kiếm:"/>
                <TextField fx:id="txtSearch" promptText="ID, email hoặc họ tên..." HBox.hgrow="ALWAYS"/>
            </HBox>

            <TableView fx:id="tblStudents" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="Không có sinh viên phù hợp"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="250"/>
                    <TableColumn fx:id="colFirstName" text="Họ" prefWidth="180"/>
                    <TableColumn fx:id="colLastName" text="Tên" prefWidth="180"/>
                    <TableColumn fx:id="colMarks" text="Điểm" prefWidth="100"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox styleClass="status-bar">
            <padding><Insets top="9" right="24" bottom="9" left="24"/></padding>
            <Label fx:id="lblStatus" text="Sẵn sàng"/>
        </HBox>
    </bottom>
</BorderPane>
