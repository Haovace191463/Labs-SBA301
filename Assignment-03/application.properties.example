spring.application.name=A3HaoVA_SE1910

# Database Configuration (Microsoft SQL Server)
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=A3HaoVA_SE1910;encrypt=true;trustServerCertificate=true
spring.datasource.username=sa
spring.datasource.password=YOUR_SQL_SERVER_PASSWORD
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver

# JPA / Hibernate Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

# Server Port
server.port=8080

# Staff Account (External configuration per Assignment 03 requirements)
hotel.staff.email=staff@fuminihotel.com
hotel.staff.password=Staff@123

# JWT Configuration
jwt.secret=YOUR_BASE64_256BIT_SECRET_KEY
jwt.expiration=86400000

